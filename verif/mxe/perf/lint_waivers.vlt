`verilator_config
// lint_waivers.vlt — waivers for FROZEN / vendored files only.
//
// NONE of the new MXE RTL (rtl/mxe/*), the SVA pack, or the scoreboard TB is
// waived here; those files must be -Wall clean on their own.
//
// apex_pkg.sv is the frozen tile-wide contract (do-not-modify). It declares
// constants for ALL blocks (ASU LUT geometry, rsqrt latency, version id), so
// any single block's build necessarily leaves some of them unreferenced.
// Waiving UNUSEDPARAM for that one file is a statement about the package's
// role, not about dead code in the MXE.
lint_off -rule UNUSEDPARAM -file "*apex_pkg.sv"
