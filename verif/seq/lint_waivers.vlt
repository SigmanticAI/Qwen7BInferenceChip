`verilator_config
// lint_waivers.vlt — waivers for the FROZEN apex_pkg.sv ONLY.
//
// apex_pkg.sv is the frozen tile-wide contract: it declares constants for
// ALL blocks, so any single-block build necessarily leaves some unused.
// NO waivers on seq_walker.sv, stream_skid.sv, the SVA checkers, or the TB.
lint_off -rule UNUSEDPARAM -file "*apex_pkg.sv"
