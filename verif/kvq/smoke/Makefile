# =============================================================================
# verif/kvq/smoke/Makefile — APEX KVQ subsystem smoke suite.
#
#   make smoke      -> lint + gen + parity + regress + summary   (the gate)
#   make lint       -> verilator --lint-only -Wall on rtl/kvq (waivers scoped
#                      per-line to rtl/kvq/cores only; kvq_engine.sv unwaived)
#   make gen        -> python-golden expected vectors for the flush regression
#                      (self-checks bit-identical vs the committed T=70 set)
#   make parity     -> the 7 parity configs + the stall config, all against
#                      rtl/kvq/kvq_engine.sv. Each run is GATED on the exact
#                      recorded check count (proof of no coverage regression).
#   make regress    -> the D-016/D-008 behavioral regressions, each proven on
#                      the clean-room kvq_engine:
#                        r_alias    D-016(c)  residual_buffer cnt==G alias
#                        r_rwait    D-016(a)  unwritten-address read hang
#                        r_collide  D-016(b)  read_req vs accepted-beat loss
#                        r_flush    D-008     partial-group flush
#
# All stimulus + expected vectors are APEX's own committed set (golden/vectors,
# generated by golden/gen_vectors.py) — the suite is self-contained. Builds
# compile -Wall with the cores' per-line waivers and the bound SVA pack
# (kvq_axis_sva.sv), and are gated on zero %Error output (assertion failures are
# build-gate failures, D-012).
#
# NOTE: earlier revisions also compiled a third-party "baseline" top to
# re-demonstrate the historical upstream bugs these behaviors fix. That checkout
# is not part of this repo (clean-room), so those baseline bug-repro halves are
# retired; the fix-side regressions below fully verify the required behavior of
# the clean-room engine.
# =============================================================================

SHELL      := /bin/bash
.SHELLFLAGS := -o pipefail -c
REPO       := ../../..
include $(REPO)/verif/tools.mk
TV         := $(REPO)/golden/vectors
G128DIR    := $(TV)/d64_T128_G128__CQ4
T70GEN     := build/gen_t70
PYTHON ?= python3

# ---- sources ----------------------------------------------------------------
# Clean-room cores (rtl/kvq/cores); package FIRST. -Wall clean, no waivers.
KVQ_CORE_FILES := cq_fp_pkg.sv cq_scale_unit.sv cq_quant_unit.sv \
                  cq_dequant_unit.sv scale_bank.sv scale_bank_store.sv \
                  cq_rne_div_pipe.sv cq_quant_pipe.sv cq_scale_pipe.sv \
                  residual_buffer.sv sram_controller.sv cq_value_path.sv \
                  cq_key_path.sv
KVQ_CORES := $(addprefix $(REPO)/rtl/kvq/cores/, $(KVQ_CORE_FILES))
KVQ_SRCS   := $(REPO)/rtl/kvq/kvq_engine.sv $(KVQ_CORES)
KVQ_SIM    := $(KVQ_SRCS) kvq_axis_sva.sv

VFLAGS_COM := --binary --timing --assert -j 0 --timescale 1ns/1ps +define+USE_SVA
VFLAGS_KVQ := $(VFLAGS_COM) -Wall lint_waivers.vlt

# ---- parity configs, verbatim -G sets (vs the committed golden vectors) ------
G_d64_cq8   := -GD=64 -GT=128 -GTIER=0 -GG=128 -GK_OUT=0 -GDEPTH=256 -GKEY_NGRP=0 -GPARTIAL_DEMO=0 \
               -GVECDIR='"$(TV)/d64_T128_G64__CQ8"' -GKEYDIR='"$(TV)/d64_T128_G64__CQ8"' -GCFGNAME='"d64_cq8"'
G_d64_cq4   := -GD=64 -GT=128 -GTIER=1 -GG=64 -GK_OUT=0 -GDEPTH=256 -GKEY_NGRP=2 -GPARTIAL_DEMO=0 \
               -GVECDIR='"$(TV)/d64_T128_G64__CQ4"' -GKEYDIR='"$(TV)/d64_T128_G64__CQ4"' -GCFGNAME='"d64_cq4"'
G_d64_cq4p  := -GD=64 -GT=128 -GTIER=2 -GG=64 -GK_OUT=2 -GDEPTH=256 -GKEY_NGRP=2 -GPARTIAL_DEMO=0 \
               -GVECDIR='"$(TV)/d64_T128_G64__CQ4plus"' -GKEYDIR='"$(TV)/d64_T128_G64__CQ4plus"' \
               -GMASKFILE='"$(TV)/d64_T128_G64__CQ4plus/outlier_mask.u8.hex"' -GCFGNAME='"d64_cq4p"'
G_d64_t70   := -GD=64 -GT=70 -GTIER=1 -GG=64 -GK_OUT=0 -GDEPTH=256 -GKEY_NGRP=1 -GPARTIAL_DEMO=1 \
               -GVECDIR='"$(TV)/d64_T70_G64__CQ4"' -GKEYDIR='"$(TV)/d64_T70_G64__CQ4"' -GCFGNAME='"d64_t70_cq4"'
G_d128_cq8  := -GD=128 -GT=100 -GTIER=0 -GG=128 -GK_OUT=0 -GDEPTH=256 -GKEY_NGRP=0 -GPARTIAL_DEMO=0 \
               -GVECDIR='"$(TV)/d128_T100_G128__CQ8"' -GKEYDIR='"$(TV)/d128_T100_G128__CQ8"' -GCFGNAME='"d128_cq8"'
G_d128_cq4  := -GD=128 -GT=100 -GTIER=1 -GG=128 -GK_OUT=0 -GDEPTH=256 -GKEY_NGRP=0 -GPARTIAL_DEMO=1 \
               -GVECDIR='"$(TV)/d128_T100_G128__CQ4"' -GKEYDIR='"$(TV)/d128_T100_G128__CQ4"' -GCFGNAME='"d128_cq4"'
G_g128_cq4  := -GD=64 -GT=128 -GTIER=1 -GG=128 -GK_OUT=0 -GDEPTH=256 -GKEY_NGRP=1 -GPARTIAL_DEMO=0 \
               -GVECDIR='"$(TV)/d64_T128_G64__CQ4"' -GKEYDIR='"$(G128DIR)"' -GCFGNAME='"g128_cq4"'
G_stall     := -GD=64 -GT=128 -GTIER=1 -GG=64 -GK_OUT=0 -GDEPTH=128 -GKEY_NGRP=1 -GSTALL_MODE=1 \
               -GSTALL_NV=8 -GSTALL_ROUNDS=3 -GEXPECT_BUG=0 \
               -GVECDIR='"$(TV)/d64_T128_G64__CQ4"' -GKEYDIR='"$(TV)/d64_T128_G64__CQ4"' -GCFGNAME='"stall_kvq"'

# recorded check counts (bit-exact record + bank + fp32 readback comparisons
# per config) — the no-coverage-regression gate.
#
# A2/D-026 KV-REC-DEDUP re-pin (2026-07-14) — counts DERIVED from the check
# structure below, then confirmed by run. Per-call subtotals in tb_kvq_top
# (STALL_MODE=0 parity flow):
#   stream_token(wait_tail)=1 · wait_idle=1 · final AXIS-monitor check=1
#   check_valrec = VPB+1+KEYG   (VPB=D CQ-8, D/2 CQ-4/+)          [UNCHANGED]
#   check_hat    = 2D+1         (D tlast + 1 no-extra-beats + D fp32 data)
#                                                                 [UNCHANGED]
#   check_keyrec = 2+K+D        (tag bit0 + ssid + K outlier lanes + D codes)
#                  [was 1+2D = tag + D fp16 fields + D codes: the per-channel
#                   fields left the record for the persistent scale bank]
#   check_bank   = D per committed group (bank row vs scale_bank.f16.hex) [NEW]
#   partial demo = 2D+7 (4 CSR checks + 1 tail + 1 idle + one 2D+1 check_hat)
# Config sums (values(T) = T + 1 + T*(VPB+1+KEYG) + T*(2D+1);
#              keygroup(G) = 1 + G*(2+K+D) + D + G*(2D+1) per committed group):
#  d64_cq8   D=64 T=128 CQ-8 (no key groups; layout untouched):
#    2*(128 + 1 + 128*65 + 128*129) + 1 = 2*24961 + 1        = 49923 (unchanged)
#  d64_cq4   D=64 T=128 G=64 K=0 NGRP=2:
#    values 128+1+128*34+128*129 = 20993
#    keys   2*(1 + 64*66 + 64 + 64*129) = 2*12545 = 25090
#    20993 + 25090 + 1                                       = 46084 (was 54020)
#  d64_cq4p  D=64 T=128 G=64 K=2 NGRP=2:
#    keys   2*(1 + 64*68 + 64 + 64*129) = 2*12673 = 25346
#    20993 + 25346 + 1                                       = 46340 (was 54020)
#  d64_t70   D=64 T=70 G=64 K=0 NGRP=1 + partial demo:
#    values 70+1+70*34+70*129 = 11481 · keys 12545 · demo 2*64+7 = 135
#    11481 + 12545 + 135 + 1                                 = 24162 (was 28130)
#  d128_cq8  D=128 T=100 CQ-8:
#    2*(100 + 1 + 100*129 + 100*257) + 1 = 2*38701 + 1       = 77403 (unchanged)
#  d128_cq4  D=128 T=100 G=128 K=0 NGRP=0 + partial demo (no group ever
#    commits -> no keyrec/bank checks):
#    values 100+1+100*66+100*257 = 32401 · demo 2*128+7 = 263
#    32401 + 263 + 1                                         = 32665 (unchanged)
#  g128_cq4  D=64 T=128 G=128 K=0 NGRP=1:
#    keys 1 + 128*66 + 64 + 128*129 = 25025
#    20993 + 25025 + 1                                       = 46019 (was 54019)
# fp32 readback + value-record subtotals are UNCHANGED by D-026 (dequant math
# identical; only the key-record composition and the scale home moved).
CHK_d64_cq8  := 49923
CHK_d64_cq4  := 46084
CHK_d64_cq4p := 46340
CHK_d64_t70  := 24162
CHK_d128_cq8 := 77403
CHK_d128_cq4 := 32665
CHK_g128_cq4 := 46019

# ---- build+run templates ------------------------------------------------------
# PARITY: $(1)=tag $(2)=-G args $(3)=expected check count
define PARITY_RUN
p_$(1):
	@mkdir -p build logs
	@echo "=== [p_$(1)] verilate + build (kvq_engine, -Wall + SVA) ==="
	$(VERILATOR) $(VFLAGS_KVQ) --Mdir build/p_$(1) -o sim --top-module tb_kvq_top \
	  $(2) tb_kvq_top.sv $(KVQ_SIM) 2>&1 | tee logs/build_p_$(1).log
	@echo "=== [p_$(1)] simulate ==="
	set -o pipefail; ./build/p_$(1)/sim 2>&1 | tee logs/run_p_$(1).log
	@grep -q "checks=$(3) fails=0" logs/run_p_$(1).log \
	  || { echo "GATE FAIL [p_$(1)]: check count != recorded ($(3)) or fails != 0"; exit 1; }
	@! grep -q "%Error" logs/run_p_$(1).log \
	  || { echo "GATE FAIL [p_$(1)]: SVA assertion errors"; exit 1; }
endef

# REGRESSION on kvq (must pass): $(1)=tag $(2)=tb top $(3)=-G args $(4)=pass-marker
define REG_FIX
r_$(1):
	@mkdir -p build logs
	@echo "=== [r_$(1)] verilate + build (kvq_engine, -Wall + SVA) ==="
	$(VERILATOR) $(VFLAGS_KVQ) --Mdir build/r_$(1) -o sim --top-module $(2) \
	  -GEXPECT_BUG=0 $(3) $(2).sv $(KVQ_SIM) 2>&1 | tee logs/build_r_$(1).log
	@echo "=== [r_$(1)] simulate ==="
	set -o pipefail; ./build/r_$(1)/sim 2>&1 | tee logs/run_r_$(1).log
	@grep -q "$(4)" logs/run_r_$(1).log \
	  || { echo "GATE FAIL [r_$(1)]: fix not proven"; exit 1; }
	@! grep -q "%Error" logs/run_r_$(1).log \
	  || { echo "GATE FAIL [r_$(1)]: SVA assertion errors"; exit 1; }
endef

$(eval $(call PARITY_RUN,d64_cq8,$(G_d64_cq8),$(CHK_d64_cq8)))
$(eval $(call PARITY_RUN,d64_cq4,$(G_d64_cq4),$(CHK_d64_cq4)))
$(eval $(call PARITY_RUN,d64_cq4p,$(G_d64_cq4p),$(CHK_d64_cq4p)))
$(eval $(call PARITY_RUN,d64_t70,$(G_d64_t70),$(CHK_d64_t70)))
$(eval $(call PARITY_RUN,d128_cq8,$(G_d128_cq8),$(CHK_d128_cq8)))
$(eval $(call PARITY_RUN,d128_cq4,$(G_d128_cq4),$(CHK_d128_cq4)))
$(eval $(call PARITY_RUN,g128_cq4,$(G_g128_cq4),$(CHK_g128_cq4)))

# stall config: gated on the explicit PASS line (no fixed check count)
p_stall:
	@mkdir -p build logs
	@echo "=== [p_stall] verilate + build (kvq_engine, -Wall + SVA) ==="
	$(VERILATOR) $(VFLAGS_KVQ) --Mdir build/p_stall -o sim --top-module tb_kvq_top \
	  $(G_stall) tb_kvq_top.sv $(KVQ_SIM) 2>&1 | tee logs/build_p_stall.log
	@echo "=== [p_stall] simulate ==="
	set -o pipefail; ./build/p_stall/sim 2>&1 | tee logs/run_p_stall.log
	@grep -q "KVQ STALL \[stall_kvq\]: PASS" logs/run_p_stall.log \
	  || { echo "GATE FAIL [p_stall]"; exit 1; }
	@! grep -q "%Error" logs/run_p_stall.log \
	  || { echo "GATE FAIL [p_stall]: SVA assertion errors"; exit 1; }

# ---- regressions (fix side, on the clean-room engine) --------------------------
G_rwait   := -GVECDIR='"$(TV)/d64_T128_G64__CQ4"'
G_collide := -GVECDIR='"$(TV)/d64_T128_G64__CQ4"'
G_flush   := -GVECDIR='"$(TV)/d64_T70_G64__CQ4"' -GKEYDIR='"$(T70GEN)"'

$(eval $(call REG_FIX,rwait,tb_kvq_rwait,$(G_rwait),D-016a RESULT \[rwait\]: PASS))
$(eval $(call REG_FIX,collide,tb_kvq_collide,$(G_collide),D-016b RESULT \[collide\]: PASS))
$(eval $(call REG_FIX,flush,tb_kvq_flush,$(G_flush),D-008 RESULT \[flush\]: PASS))

# alias regression is UNIT-level: the clean-room residual_buffer must drop the
# cnt==G overflow write (D-016c)
r_alias:
	@mkdir -p build logs
	@echo "=== [r_alias] verilate + build (clean-room residual_buffer, -Wall) ==="
	$(VERILATOR) $(VFLAGS_COM) -Wall --Mdir build/r_alias -o sim \
	  --top-module tb_residual_alias -GEXPECT_BUG=0 \
	  tb_residual_alias.sv $(REPO)/rtl/kvq/cores/residual_buffer.sv 2>&1 | tee logs/build_r_alias.log
	@echo "=== [r_alias] simulate ==="
	set -o pipefail; ./build/r_alias/sim 2>&1 | tee logs/run_r_alias.log
	@grep -q "D-016c RESULT \[resid_alias\]: PASS" logs/run_r_alias.log \
	  || { echo "GATE FAIL [r_alias]"; exit 1; }

# ---- top-level targets ----------------------------------------------------------
.PHONY: smoke lint gen parity regress summary clean p_stall r_alias

smoke: lint gen parity regress summary

lint:
	@mkdir -p logs
	$(VERILATOR) --lint-only -Wall --timing lint_waivers.vlt \
	  --top-module kvq_engine $(KVQ_SRCS) 2>&1 | tee logs/lint.log
	@echo "LINT CLEAN (-Wall; waivers scoped per-line to rtl/kvq/cores/* only)"

gen:
	@mkdir -p build logs
	set -o pipefail; $(PYTHON) gen_kvq_vectors.py $(T70GEN) 2>&1 | tee logs/gen.log
	@grep -q "GEN SELF-CHECK" logs/gen.log

parity: p_d64_cq8 p_d64_cq4 p_d64_cq4p p_d64_t70 p_d128_cq8 p_d128_cq4 p_g128_cq4 p_stall

regress: r_alias r_rwait r_collide r_flush

summary:
	@echo ""
	@echo "==================== KVQ SMOKE SUMMARY ===================="
	@for f in logs/run_*.log; do \
	  echo "--- $$f"; \
	  grep -E "KVQ PARITY|KVQ STALL|RESULT \[|WATCHDOG|checks=|confirmed:" $$f | sed 's/^/    /'; \
	done
	@echo "==========================================================="

clean:
	rm -rf build logs
